# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，严禁提交真实 key。

# --- 密钥 / endpoint ---
# 通用 DASHSCOPE_* 配置：
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 若本机系统环境变量里另有一把 DASHSCOPE_API_KEY（会压过 .env），或想给 Markr 单独配 key，
# 用下面两个 MARKR_* 变量，优先级高于 DASHSCOPE_*（留空或不写则回退 DASHSCOPE_*）：
#MARKR_API_KEY=sk-your-markr-key-here
#MARKR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- 模型名（需支持 function calling，以百炼控制台为准）---
# 主对话 / 编排模型，默认 deepseek-v4-pro（实测编排不能用弱模型）：
MARKR_QWEN_MODEL=deepseek-v4-pro
# grade_text 批改主力模型，默认同主模型 deepseek-v4-pro：
MARKR_GRADE_MODEL=deepseek-v4-pro
# 视觉（图片转写）模型，默认 qwen3-vl-flash：真样张冒烟里它最忠实——
# 不擅自润色原文的字（plus 会把 late 悄悄改成 ate，等于藏掉真实错误），
# 也不像 qwen-vl-ocr-latest 那样把界面按钮、用户真名、分数一并抄进来。
#MARKR_VISION_MODEL=qwen3-vl-flash

# 单次回复的输出 token 额度：先用基础额（默认 8192），回复被截断时静默升档到升级额
# （默认 65536）重发；升档后仍截断则续给下一轮并拼接。一般无需修改。
MARKR_MAX_TOKENS=8192
MARKR_MAX_TOKENS_UPGRADE=65536

# 流式空闲超时（秒）：模型连上后若连续这么久一个字都不吐（服务端卡住 / 网络静默假死），
# 自动重发当前轮；应短于客户端读取超时。默认 90，一般无需修改。
#MARKR_STREAM_IDLE_TIMEOUT=90

# --- OCR（图片转写）---
# 单张图片的字节上限（默认 10MB）：超过直接报错请人压缩，不硬塞给视觉模型。
#MARKR_OCR_MAX_BYTES=10485760

# --- 复核（老师驳回一条 → AI 拿上下文重判）---
# 同一条最多复核几次（默认 2）：用完这条的「驳回」降级为「剔除」。
#MARKR_RECHECK_MAX_ROUNDS=2
# 一篇作文累计最多复核几次（默认 5）：由 web 端记账拦截，这里只是配置单点。
#MARKR_RECHECK_MAX_TOTAL=5
# 给模型看的上下文字符硬顶（默认 4096）：超过按最近句尾左截，
# 防止「整篇只有一段」时上下文等于全文、退化成整篇重批。
#MARKR_RECHECK_MAX_CONTEXT_CHARS=4096
# 句子不足多少个词就升级到段落（默认 8）：短句里判断不了指代、跨句时态。
#MARKR_RECHECK_MIN_CONTEXT_WORDS=8
# --- 日志（后端看不到过程时用）---
# 级别：DEBUG / INFO / WARNING / ERROR，默认 INFO；空或写错一律回退 INFO（不炸启动）。
# 看得到什么：每轮一行（轮次 / 停止原因 / token / 耗时）、每个工具一条、
#   每次运行终态一行、建连重试一行。不含作文原文、不含 key、不含模型回复正文。
#MARKR_LOG_LEVEL=INFO
#
# 日志文件：默认 ~/.markr/logs/backend.log，轮转 2MB x 3 封顶（约 8MB）。
# 显式设成空串 = 关掉文件出口、只留控制台（这一条刻意保留空串语义）。
#MARKR_LOG_FILE=
